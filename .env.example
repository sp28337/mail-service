# =============================================================================
# mail-service — production environment file
# Copy to .env and fill in real values. chmod 600 .env
# =============================================================================

# ── App ───────────────────────────────────────────────────────────────────────
#APP_ENV=production
APP_ENV=dev
LOG_LEVEL=INFO

# ── Redis (bare-metal: localhost; Docker: redis service name) ─────────────────
# Password MUST match requirepass in redis.conf
REDIS_PORT=6379
REDIS_PASSWORD=strong_passwod
REDIS_URL=redis://:strong_passwod@redis:6379/0

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:strong_passwod@redis:6379/0
CELERY_RESULT_BACKEND=redis://:strong_passwod@redis:6379/1
# NEVER set to true in production
CELERY_TASK_ALWAYS_EAGER=false

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USERNAME=service@example.com
SMTP_PASSWORD=strong_passwod
SMTP_USE_TLS=true
SMTP_USE_STARTTLS=false

# ── Mail sender identity ──────────────────────────────────────────────────────
MAIL_FROM_NAME="Mail Service"
MAIL_FROM_EMAIL=service@example.com
# Notification recipient for /notify-mail/* endpoints
MAIL_REPLY_TO=admin@example.com

# ── Templates ─────────────────────────────────────────────────────────────────
TEMPLATE_DIRECTORY=app/templates